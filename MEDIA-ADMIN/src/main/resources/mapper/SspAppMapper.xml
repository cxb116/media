<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.media.admin.mapper.SspAppMapper">
  <resultMap id="map" type="com.media.admin.entity.SspApp">
    <id property="id" column="id" />
    <result property="mediaId" column="media_id" />
    <result property="osType" column="os_type" />
    <result property="accessType" column="access_type" />
    <result property="downloadUrl" column="download_url" />
    <result property="createBy" column="create_by" />
    <result property="createTime" column="create_time" />
    <result property="updateBy" column="update_by" />
    <result property="updateTime" column="update_time" />
  </resultMap>
  <sql id="columns">
    id, media_id, name, os_type, access_type, pkg, download_url,
    enable, create_by, create_time, update_by, update_time, remark
  </sql>
  <select id="selectById" resultMap="map">
    SELECT <include refid="columns" /> FROM ssp_app WHERE id = #{id}
  </select>
  <select id="selectByMediaId" resultMap="map">
    SELECT <include refid="columns" /> FROM ssp_app
    WHERE media_id = #{mediaId} ORDER BY id DESC
  </select>
  <select id="selectByMediaIdAndEnable" resultMap="map">
    SELECT <include refid="columns" /> FROM ssp_app
    WHERE media_id = #{mediaId} AND enable = #{enable} ORDER BY id DESC
  </select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO ssp_app (media_id,name,os_type,access_type,pkg,download_url,enable,create_by,remark)
    VALUES (#{mediaId},#{name},#{osType},#{accessType},#{pkg},#{downloadUrl},#{enable},#{createBy},#{remark})
  </insert>
  <update id="update">
    UPDATE ssp_app SET name=#{name}, os_type=#{osType}, access_type=#{accessType}, pkg=#{pkg},
      download_url=#{downloadUrl}, enable=#{enable}, remark=#{remark}, update_time=NOW()
    WHERE id=#{id}
  </update>
  <delete id="deleteById">DELETE FROM ssp_app WHERE id=#{id}</delete>
  <delete id="deleteByMediaId">DELETE FROM ssp_app WHERE media_id=#{mediaId}</delete>
</mapper>
